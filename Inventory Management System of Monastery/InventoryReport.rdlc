											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="dat5">
											<Value>=Fields!total_sold.Value</Value>
											<Style>
												<FontSize>8pt</FontSize>
												<TextAlign>Center</TextAlign>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="dat6">
											<Value>=Fields!total_purchased.Value</Value>
											<Style>
												<FontSize>8pt</FontSize>
												<TextAlign>Center</TextAlign>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="dat7">
											<Value>=Fields!stock_status.Value</Value>
