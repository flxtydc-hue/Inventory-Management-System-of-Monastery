											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="dat2">
											<Value>=Fields!category_name.Value</Value>
											<Style>
												<FontSize>8pt</FontSize>
												<TextAlign>Center</TextAlign>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="dat3">
											<Value>=Fields!current_stock.Value</Value>
											<Style>
												<FontSize>8pt</FontSize>
												<TextAlign>Center</TextAlign>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
