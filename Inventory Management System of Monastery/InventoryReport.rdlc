												<FontWeight>Bold</FontWeight>
												<BackgroundColor>#2980B9</BackgroundColor>
												<Color>White</Color>
												<TextAlign>Center</TextAlign>
												<FontSize>8pt</FontSize>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="hdr5">
											<Value>Total Sold</Value>
											<Style>
												<FontWeight>Bold</FontWeight>
												<BackgroundColor>#2980B9</BackgroundColor>
												<Color>White</Color>
												<TextAlign>Center</TextAlign>
												<FontSize>8pt</FontSize>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
