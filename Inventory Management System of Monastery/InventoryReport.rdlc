<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
	<DataSources>
		<DataSource Name="DataSource1">
			<ConnectionProperties>
				<DataProvider>System.Data.DataSet</DataProvider>
				<ConnectString />
			</ConnectionProperties>
		</DataSource>
	</DataSources>
	<DataSets>
		<DataSet Name="DataSet1">
			<Fields>
				<Field Name="product_name">
					<DataField>product_name</DataField>
				</Field>
				<Field Name="category_name">
					<DataField>category_name</DataField>
				</Field>
				<Field Name="current_stock">
					<DataField>current_stock</DataField>
				</Field>
				<Field Name="low_stock_threshold">
					<DataField>low_stock_threshold</DataField>
				</Field>
				<Field Name="total_sold">
					<DataField>total_sold</DataField>
				</Field>
				<Field Name="total_purchased">
					<DataField>total_purchased</DataField>
				</Field>
				<Field Name="stock_status">
					<DataField>stock_status</DataField>
				</Field>
			</Fields>
			<Query>
				<DataSourceName>DataSource1</DataSourceName>
				<CommandText />
			</Query>
		</DataSet>
	</DataSets>
	<ReportParameters>
		<ReportParameter Name="ReportTitle">
			<DataType>String</DataType>
			<DefaultValue>
				<Values>
					<Value>Inventory Summary Report</Value>
				</Values>
			</DefaultValue>
		</ReportParameter>
		<ReportParameter Name="StartDate">
			<DataType>String</DataType>
			<DefaultValue>
				<Values>
					<Value />
				</Values>
			</DefaultValue>
		</ReportParameter>
		<ReportParameter Name="EndDate">
			<DataType>String</DataType>
			<DefaultValue>
				<Values>
					<Value />
				</Values>
			</DefaultValue>
		</ReportParameter>
	</ReportParameters>
	<Body>
		<ReportItems>
			<Textbox Name="txtTitle">
				<Value>=Parameters!ReportTitle.Value</Value>
				<Top>0in</Top>
				<Left>0in</Left>
				<Width>7in</Width>
				<Height>0.3in</Height>
				<Style>
					<FontSize>14pt</FontSize>
					<FontWeight>Bold</FontWeight>
					<TextAlign>Center</TextAlign>
				</Style>
			</Textbox>
			<Textbox Name="txtDate">
				<Value>="Period: " &amp; Parameters!StartDate.Value &amp; " - " &amp; Parameters!EndDate.Value</Value>
				<Top>0.3in</Top>
				<Left>0in</Left>
				<Width>7in</Width>
				<Height>0.25in</Height>
				<Style>
					<FontSize>9pt</FontSize>
					<TextAlign>Center</TextAlign>
				</Style>
			</Textbox>
			<Tablix Name="InventoryTable">
				<TablixBody>
					<TablixColumns>
						<TablixColumn>
							<Width>1.5in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>1in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>1in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>1in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>1in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>1in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>1in</Width>
						</TablixColumn>
					</TablixColumns>
					<TablixRows>
						<TablixRow>
							<Height>0.25in</Height>
							<TablixCells>
								<TablixCell>
									<CellContents>
										<Textbox Name="hdr1">
											<Value>Product</Value>
											<Style>
												<FontWeight>Bold</FontWeight>
												<BackgroundColor>#2980B9</BackgroundColor>
												<Color>White</Color>
												<TextAlign>Center</TextAlign>
												<FontSize>8pt</FontSize>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="hdr2">
											<Value>Category</Value>
											<Style>
												<FontWeight>Bold</FontWeight>
												<BackgroundColor>#2980B9</BackgroundColor>
												<Color>White</Color>
												<TextAlign>Center</TextAlign>
												<FontSize>8pt</FontSize>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="hdr3">
											<Value>Current Stock</Value>
											<Style>
