												<BackgroundColor>#2980B9</BackgroundColor>
												<Color>White</Color>
												<TextAlign>Center</TextAlign>
												<FontSize>8pt</FontSize>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="hdr7">
											<Value>Stock Status</Value>
											<Style>
												<FontWeight>Bold</FontWeight>
												<BackgroundColor>#2980B9</BackgroundColor>
												<Color>White</Color>
												<TextAlign>Center</TextAlign>
												<FontSize>8pt</FontSize>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
							</TablixCells>
						</TablixRow>
						<TablixRow>
							<Height>0.25in</Height>
							<TablixCells>
								<TablixCell>
									<CellContents>
										<Textbox Name="dat1">
											<Value>=Fields!product_name.Value</Value>
											<Style>
