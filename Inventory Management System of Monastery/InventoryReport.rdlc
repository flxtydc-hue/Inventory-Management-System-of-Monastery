				</TablixBody>
				<TablixColumnHierarchy>
					<TablixMembers>
						<TablixMember />
						<TablixMember />
						<TablixMember />
						<TablixMember />
						<TablixMember />
						<TablixMember />
						<TablixMember />
					</TablixMembers>
				</TablixColumnHierarchy>
				<TablixRowHierarchy>
					<TablixMembers>
						<TablixMember>
							<TablixHeader>
								<Size>1in</Size>
							</TablixHeader>
						</TablixMember>
						<TablixMember>
							<Group Name="Detail" />
						</TablixMember>
					</TablixMembers>
				</TablixRowHierarchy>
				<Top>0.6in</Top>
				<Left>0in</Left>
				<Width>7.5in</Width>
			</Tablix>
